# Development uses deterministic local embeddings. Production recommendation:
# FINSIGHT_EMBEDDINGS=sentence_transformers
# FINSIGHT_EMBEDDING_MODEL=BAAI/bge-m3
FINSIGHT_EMBEDDINGS=hash
FINSIGHT_EMBEDDING_MODEL=BAAI/bge-m3
# none | openai_compatible (use Ollama through its OpenAI-compatible endpoint)
FINSIGHT_LLM_PROVIDER=none
FINSIGHT_LLM_MODEL=qwen2.5:14b-instruct
FINSIGHT_LLM_BASE_URL=http://localhost:11434/v1
FINSIGHT_LLM_API_KEY=
FINSIGHT_EMBEDDING_BASE_URL=http://localhost:11434

# to use LangSmith, set the API key here.
# LANGSMITH_API_KEY=lsv2_pt_*


